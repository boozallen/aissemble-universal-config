<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.boozallen.aissemble</groupId>
        <artifactId>aissemble-parent</artifactId>
        <version>7</version>
        <relativePath />
    </parent>

    <artifactId>aissemble-universal-config</artifactId>
    <version>0.1.0</version>

    <name>aiSSEMBLE::Universal Config</name>
    <description>aiSSEMBLE universal configuration</description>
    <packaging>pom</packaging>

    <url>https://github.com/boozallen/aissemble-universal-config</url>
    <inceptionYear>2024</inceptionYear>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/boozallen/aissemble-universal-config/issues</url>
    </issueManagement>

    <scm>
        <connection>scm:git:ssh://git@github.com/boozallen/aissemble-universal-config.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/boozallen/aissemble-universal-config.git</developerConnection>
        <url>https://github.com/boozallen/aissemble-universal-config</url>
        <tag>aissemble-universal-config-0.1.0</tag>
    </scm>

    <organization>
        <name>Booz Allen Hamilton Inc.</name>
        <url>https://www.boozallen.com</url>
    </organization>

    <developers>
        <developer>
            <id>aissemble</id>
            <name>aiSSEMBLE Baseline Community</name>
            <organization>Booz Allen Hamilton</organization>
            <organizationUrl>https://boozallen.com</organizationUrl>
            <email>aissemble@bah.com</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Booz Allen Public License v1.0</name>
            <url>https://github.com/boozallen/Public-License/blob/master/LICENSE.md</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>aissemble-universal-config-loader</module>
    </modules>

    <properties>
        <version.habushu.plugin>3.1.1</version.habushu.plugin>
        <version.python>3.11.4</version.python>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.technologybrewery.habushu</groupId>
                    <artifactId>habushu-maven-plugin</artifactId>
                    <version>${version.habushu.plugin}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <pythonVersion>${version.python}</pythonVersion>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Apply licenses automatically -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
